    "spec_sha256": "09c9f978c38c770a71160ade6c9ab7fef7cc03601db4e215214d6e8e3f9b8802",
    "preset": {
      "id": "rm_flux",
      "version": "1.0.0"
    },
    "input_files": [
      {
        "name": "Sample_GL_2026.csv",
        "sha256": "0136e4a15d177b4fc05eae2908fe6afed79ef71a1ee4028333e677ccf807b1bd",
        "role": "primary",
        "definition": {
          "sheet": "(csv)",
          "header_row": 1,
          "start_col": "A",
          "end_col": null,
          "role": "primary",
          "name": "Sample_GL_2026",
          "combine_sheets": [],
          "tag_column": null
        }
      },
      {
        "name": "Sample_Open_PO.xlsx",
        "sha256": "1031524368f0d3cba3d92f4585c86fdd1149335fa7995bd0c67cea0049fed807",
        "role": "lookup",
        "definition": {
          "sheet": "Open PO Report ",
          "header_row": 1,
          "start_col": "A",
          "end_col": null,
          "role": "lookup",
          "name": "open_po",
          "combine_sheets": [],
          "tag_column": null
        }
      }
    ]
  }
}